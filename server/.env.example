# Server Port (Auto-assigned by cloud hosts like Render/Heroku/Railway)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fupre-cbt-db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fupre-cbt-db

# Strong JWT Secret Key (Generate a random 32+ character string)
JWT_SECRET=your_jwt_secret_key_here
